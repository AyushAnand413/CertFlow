# ==============================================================================
# CertFlow Environment Configuration Template
# Copy this file to .env to customize settings:
#   cp .env.example .env
# ==============================================================================

# Application
APP_NAME=CertFlow
ENV=development
DEBUG=false

# Database Connection (PostgreSQL or SQLite fallback)
# For Docker Compose (configured automatically in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://certflow:certflow_secret@postgres:5432/certflow
#
# For Local Native PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/certflow
#
# For Instant Zero-Config Local SQLite Testing:
DATABASE_URL=sqlite:///./certflow.db

# Storage Directory for generated PDFs
STORAGE_DIR=./storage/certificates

# Worker & Queue Configuration
MAX_RECIPIENTS_PER_JOB=10000
WORKER_BATCH_SIZE=50
WORKER_LOCK_TIMEOUT_SECONDS=120
WORKER_POLL_INTERVAL_SECONDS=1.0
MAX_ATTEMPTS=3

# Public Base URL for embedding QR verification links in certificates
VERIFICATION_BASE_URL=http://localhost:8000/verify
